    "# ==============================================================================\n",
    "# CELL 2: Industrial IoT Telemetry Generator\n",
    "# ==============================================================================\n",
    "def generate_industrial_telemetry(n_samples=250, random_state=42):\n",
    "    \"\"\"\n",
    "    Simulates multi-sensor time-series telemetry with white noise,\n",
    "    harmonic vibration chattering, and thermal escalation.\n",
    "    \"\"\"\n",
    "    np.random.seed(random_state)\n",
    "    time_index = pd.date_range(start='2026-10-15 00:00:00', periods=n_samples, freq='10min')\n",
    "    \n",
    "    # Progress factor [0.0 to 1.0] representing operational degradation timeline\n",
    "    t = np.linspace(0, 1, n_samples)\n",
    "    \n",
    "    # 1. Stator Core Temperature (°C): Escalating non-linearly to 94°C\n",
    "    base_temp = 55.0 + (t ** 2.2) * 36.0\n",
    "    temp_noise = np.random.normal(0, 1.2, n_samples)\n",
    "    temperature = np.clip(base_temp + temp_noise, 35.0, 105.0)\n",
    "    \n",
    "    # 2. Vibration Velocity (mm/s): ISO-10816 standards (Zone A < 2.5, Zone D Critical > 6.8)\n",
    "    base_vib = 1.8 + (t ** 2.0) * 5.2\n",
    "    vib_harmonics = 0.4 * np.sin(2 * np.pi * t * 15)  # Harmonic bearing chatter\n",
    "    vib_noise = np.random.normal(0, 0.25, n_samples)\n",
    "    vibration = np.clip(base_vib + vib_harmonics + vib_noise, 0.5, 9.5)\n",
    "    \n",
    "    # 3. Hydraulic Differential Pressure (bar): Baseline ~4.2 bar with gradual drop\n",
    "    base_pressure = 4.2 - 0.6 * (t ** 1.8)\n",
    "    pressure_noise = np.random.normal(0, 0.15, n_samples)\n",
    "    pressure = np.clip(base_pressure + pressure_noise, 1.5, 8.5)\n",
    "    \n",
    "    # 4. Rotational Speed (RPM): 1800 RPM synchronous speed with load slip\n",
    "    rpm = np.random.normal(1800.0, 15.0, n_samples) - (t ** 2) * 45.0\n",
    "    \n",
    "    # 5. Electrical Current Draw (A): Increases as mechanical binding escalates\n",
    "    base_current = 14.5 + (t ** 1.9) * 15.5\n",
    "    current_noise = np.random.normal(0, 0.4, n_samples)\n",
    "    current = np.clip(base_current + current_noise, 8.0, 36.0)\n",
    "    \n",
    "    # 6. Cumulative Operating Hours\n",
    "    operating_hours = 3800.0 + np.cumsum(np.ones(n_samples) * (10 / 60))\n",
    "    \n",
    "    df = pd.DataFrame({\n",
    "        'timestamp': time_index,\n",
    "        'temperature': np.round(temperature, 2),\n",
    "        'vibration': np.round(vibration, 2),\n",
    "        'pressure': np.round(pressure, 2),\n",
    "        'rpm': np.round(rpm, 1),\n",
    "        'current': np.round(current, 2),\n",
    "        'operating_hours': np.round(operating_hours, 2)\n",
    "    })\n",
    "    return df\n",
    "\n",
    "df_telemetry = generate_industrial_telemetry(n_samples=250)\n",
    "print(f\"✅ Generated {len(df_telemetry)} telemetry records.\")\n",
    "df_telemetry.head()"
   ]
