    "# ==============================================================================\n",
    "# CELL 3: Industrial Feature Engineering\n",
    "# ==============================================================================\n",
    "def engineer_features(df):\n",
    "    df_feat = df.copy()\n",
    "    \n",
    "    baseline_temp = 55.0\n",
    "    baseline_vib = 2.2\n",
    "    baseline_curr = 14.5\n",
    "    \n",
    "    # Physical stress derivatives\n",
    "    df_feat['temp_delta'] = np.maximum(0.0, df_feat['temperature'] - baseline_temp)\n",
    "    df_feat['temp_ratio'] = df_feat['temperature'] / baseline_temp\n",
    "    df_feat['vib_ratio'] = df_feat['vibration'] / baseline_vib\n",
    "    df_feat['current_per_krpm'] = df_feat['current'] / (df_feat['rpm'] / 1000.0)\n",
    "    df_feat['pressure_delta'] = np.abs(df_feat['pressure'] - 4.2)\n",
    "    \n",
    "    # Cumulative Thermal-Wear Index\n",
    "    hours_norm = np.clip(df_feat['operating_hours'] / 5000.0, 0.0, 1.0)\n",
    "    df_feat['thermal_wear_index'] = df_feat['temp_ratio'] * (1.0 + 0.5 * hours_norm)\n",
    "    \n",
    "    # Combined Multivariate Stress Index\n",
    "    df_feat['multivariate_stress'] = (\n",
    "        0.35 * (df_feat['vib_ratio'] ** 1.3) +\n",
    "        0.30 * (df_feat['temp_ratio'] ** 1.2) +\n",
    "        0.20 * (1.0 + df_feat['pressure_delta']) +\n",
    "        0.15 * (df_feat['current'] / baseline_curr)\n",
    "    )\n",
    "    \n",
    "    return df_feat\n",
    "\n",
    "df_engineered = engineer_features(df_telemetry)\n",
    "feature_cols = [\n",
    "    'temperature', 'vibration', 'pressure', 'rpm', 'current',\n",
    "    'temp_delta', 'vib_ratio', 'current_per_krpm', 'pressure_delta', 'multivariate_stress'\n",
    "]\n",
    "print(f\"✅ Computed {len(feature_cols)} engineered features.\")"
   ]
